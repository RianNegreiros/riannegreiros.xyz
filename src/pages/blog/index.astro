---
import BaseLayout from '@/layouts/BaseLayout.astro'
import BlogList from '@/components/blog/BlogList'
import { fetchPosts, getTotalPosts } from '@/lib/api'

export const prerender = false
Astro.response.headers.set(
  'Cache-Control',
  's-maxage=60, stale-while-revalidate=300',
)

const pageParam = Number(Astro.url.searchParams.get('page') ?? 1)
const currentPage = Math.max(1, pageParam) - 1

const [initialPosts, initialTotal] = await Promise.all([
  fetchPosts(currentPage, 10),
  getTotalPosts(),
])
---

<BaseLayout
  title="Blog | Rian Negreiros"
  description="Artigos técnicos e insights sobre engenharia de software, desenvolvimento web, Java, Golang, C# e arquitetura de sistemas."
>
  <div class="mx-auto w-full max-w-4xl">
    <BlogList
      initialPosts={initialPosts}
      initialTotal={initialTotal}
      client:load
    />
  </div>
</BaseLayout>
